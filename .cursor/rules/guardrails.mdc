### 7. Form Component Implementation with Guardrails
```
Implement these patterns in all form components:

1. CONTROLLED INPUTS WITH VALIDATION:
   - Always use controlled inputs
   - Validate on blur and before submission
   - Provide immediate feedback for validation errors
   - Sanitize inputs before submission

2. FORM STATE MANAGEMENT:
   - Use React Hook Form for complex forms
   - Implement proper form state reset after submission
   - Handle loading states properly
   - Provide clear success/error feedback

3. FIELD-LEVEL VALIDATION:
   - Implement field-specific validation rules
   - Validate related fields together (e.g., password confirmation)
   - Implement cross-field validation when necessary

4. IMPLEMENTATION EXAMPLE:

import { useState } from 'react';
import { useForm } from 'react-hook-form';
import { yupResolver } from '@hookform/resolvers/yup';
import * as yup from 'yup';
import { sanitizeObject } from '../utils/security';

const formSchema = yup.object({
  email: yup
    .string()
    .required('Email is required')
    .email('Please enter a valid email'),
  password: yup
    .string()
    .required('Password is required')
    .min(8, 'Password must be at least 8 characters'),
  confirmPassword: yup
    .string()
    .required('Please confirm your password')
    .oneOf([yup.ref('password')], 'Passwords must match')
});

function SecureForm() {
  const [loading, setLoading] = useState(false);
  const [serverError, setServerError] = useState('');
  
  const { 
    register, 
    handleSubmit, 
    formState: { errors },
    reset 
  } = useForm({
    resolver: yupResolver(formSchema),
    mode: 'onBlur' // Validate on blur
  });
  
  const onSubmit = async (data) => {
    setLoading(true);
    setServerError('');
    
    try {
      // Sanitize data before sending to API
      const sanitizedData = sanitizeObject(data);
      
      // API call
      const response = await apiService.register(sanitizedData);
      
      // Handle success
      reset(); // Clear form
      // Navigate or show success message
    } catch (error) {
      // Handle error
      setServerError(
        error.response?.data?.message || 
        'An error occurred. Please try again.'
      );
    } finally {
      setLoading(false);
    }
  };
  
  return (
    <form onSubmit={handleSubmit(onSubmit)}>
      {serverError && <div className="error">{serverError}</div>}
      
      <div>
        <label htmlFor="email">Email</label>
        <input 
          id="email"
          type="email" 
          {...register('email')} 
        />
        {errors.email && <p>{errors.email.message}</p>}
      </div>
      
      <div>
        <label htmlFor="password">Password</label>
        <input 
          id="password"
          type="password" 
          {...register('password')} 
        />
        {errors.password && <p>{errors.password.message}</p>}
      </div>
      
      <div>
        <label htmlFor="confirmPassword">Confirm Password</label>
        <input 
          id="confirmPassword"
          type="password" 
          {...register('confirmPassword')} 
        />
        {errors.confirmPassword && <p>{errors.confirmPassword.message}</p>}
      </div>
      
      <button 
        type="submit" 
        disabled={loading}
      >
        {loading ? 'Submitting...' : 'Submit'}
      </button>
    </form>
  );
}
```

