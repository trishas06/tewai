### 3. API Data Validation
```
// Standardize API request validation pattern:

// 1. Create a validation function
function validateAPIData(data, schema) {
  try {
    const validatedData = schema.validateSync(data, { abortEarly: false });
    return { isValid: true, data: validatedData, errors: null };
  } catch (validationError) {
    const errors = validationError.inner.reduce((acc, error) => {
      return { ...acc, [error.path]: error.message };
    }, {});
    return { isValid: false, data: null, errors };
  }
}

// 2. Use it before making API calls
async function submitFormToAPI(formData) {
  const { isValid, data, errors } = validateAPIData(formData, formSchema);
  
  if (!isValid) {
    // Handle validation errors
    return { success: false, errors };
  }
  
  try {
    // Safe to proceed with API call
    const response = await axiosInstance.post('/api/endpoint', data);
    return { success: true, data: response.data };
  } catch (error) {
    return { success: false, errors: { server: error.message } };
  }
}
