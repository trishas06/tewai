### 8. API Request Security Patterns
```
Implement these patterns for all API requests:

1. REQUEST INTERCEPTORS:
   - Add authentication tokens
   - Implement request logging if needed
   - Sanitize request data

2. RESPONSE INTERCEPTORS:
   - Handle authentication errors
   - Sanitize response data
   - Handle global error states

3. CANCEL TOKENS:
   - Implement cancellation for requests that may become stale
   - Cancel pending requests on component unmount

4. IMPLEMENTATION EXAMPLE:

import axios from 'axios';
import { sanitizeObject } from './security';

// Create a custom instance
const api = axios.create({
  baseURL: process.env.VITE_API_BASE_URL,
  headers: {
    'Content-Type': 'application/json',
  },
  timeout: 10000, // 10 seconds
});

// Request interceptor
api.interceptors.request.use(
  (config) => {
    // Add authentication token
    const token = getAuthToken();
    if (token) {
      config.headers.Authorization = `Bearer ${token}`;
    }
    
    // Sanitize request data if it exists
    if (config.data) {
      config.data = sanitizeObject(config.data);
    }
    
    return config;
  },
  (error) => Promise.reject(error)
);

// Response interceptor
api.interceptors.response.use(
  (response) => {
    // Sanitize response data
    if (response.data) {
      response.data = sanitizeObject(response.data);
    }
    return response;
  },
  (error) => {
    // Handle authentication errors
    if (error.response?.status === 401) {
      // Clear auth state and redirect to login
      logout();
      window.location.href = '/login';
    }
    
    // Handle other errors
    return Promise.reject(error);
  }
);

// Example function with cancel token
export const searchData = (query) => {
  const source = axios.CancelToken.source();
  
  const promise = api.get('/search', {
    params: { q: query },
    cancelToken: source.token
  });
  
  // Add cancel method to the promise
  promise.cancel = () => {
    source.cancel('Request cancelled');
  };
  
  return promise;
};

// Usage in component
function SearchComponent() {
  const [query, setQuery] = useState('');
  
  useEffect(() => {
    if (!query) return;
    
    const request = searchData(query);
    
    return () => {
      // Cancel request on component unmount or query change
      request.cancel();
    };
  }, [query]);
  
  // Rest of component
}
```

