### 1. Test File Structure and Naming
```typescript
// File naming convention: ComponentName.test.tsx or ComponentName.spec.tsx
// Group related tests using describe blocks
// Use clear test descriptions with "it" or "test"

// Example structure:
import { describe, it, expect, beforeEach, afterEach } from 'vitest';
import { render, screen, fireEvent } from '@testing-library/react';
import { ComponentName } from './ComponentName';

describe('ComponentName', () => {
  beforeEach(() => {
    // Setup before each test
  });

  afterEach(() => {
    // Cleanup after each test
  });

  describe('initialization', () => {
    it('should render without crashing', () => {
      render(<ComponentName />);
      expect(screen.getByTestId('component')).toBeDefined();
    });
  });

  describe('functionality', () => {
    it('should handle user interactions', () => {
      // Test specific functionality
    });
  });
});
```

### 2. Testing Hooks Guidelines
```typescript
// Use renderHook for testing custom hooks
import { renderHook, act } from '@testing-library/react';

describe('useCustomHook', () => {
  it('should handle state updates', () => {
    const { result } = renderHook(() => useCustomHook());

    act(() => {
      result.current.someFunction();
    });

    expect(result.current.value).toBe(expectedValue);
  });
});
```

### 3. Mocking Patterns
```typescript
// 1. Function Mocks
const mockFunction = vi.fn();

// 2. Module Mocks
vi.mock('./path/to/module', () => ({
  default: vi.fn(),
  namedExport: vi.fn()
}));

// 3. API Mocks
vi.mock('axios', () => ({
  default: {
    get: vi.fn(() => Promise.resolve({ data: mockData })),
    post: vi.fn(() => Promise.resolve({ data: mockResponse }))
  }
}));

// 4. Timer Mocks
beforeEach(() => {
  vi.useFakeTimers();
});

afterEach(() => {
  vi.useRealTimers();
});

it('should handle timeouts', () => {
  // Arrange
  render(<Component />);
  
  // Act
  vi.advanceTimersByTime(1000);
  
  // Assert
  expect(screen.getByText('Updated')).toBeDefined();
});
```

### 4. Common Test Scenarios
```typescript
// 1. Testing Props
it('should render with props', () => {
  const props = {
    title: 'Test Title',
    onClick: vi.fn()
  };
  
  render(<Component {...props} />);
  expect(screen.getByText(props.title)).toBeDefined();
});

// 2. Testing Events
it('should handle click events', () => {
  const handleClick = vi.fn();
  render(<Button onClick={handleClick}>Click Me</Button>);
  
  fireEvent.click(screen.getByText('Click Me'));
  expect(handleClick).toHaveBeenCalledTimes(1);
});

// 3. Testing Async Operations
it('should handle async operations', async () => {
  const mockData = { id: 1, name: 'Test' };
  const mockFetch = vi.fn(() => Promise.resolve(mockData));
  
  render(<AsyncComponent fetch={mockFetch} />);
  
  expect(screen.getByText('Loading...')).toBeDefined();
  await screen.findByText(mockData.name);
  expect(mockFetch).toHaveBeenCalled();
});
```

### 5. Testing Redux/State Management
```typescript
// 1. Testing Reducers
describe('reducer', () => {
  it('should handle initial state', () => {
    expect(reducer(undefined, { type: 'unknown' })).toEqual(initialState);
  });

  it('should handle specific action', () => {
    const previousState = initialState;
    const action = { type: 'increment' };
    const expectedState = { ...initialState, value: 1 };
    
    expect(reducer(previousState, action)).toEqual(expectedState);
  });
});

// 2. Testing Connected Components
import { Provider } from 'react-redux';
import { configureStore } from '@reduxjs/toolkit';

const renderWithRedux = (
  component,
  {
    initialState = {},
    store = configureStore({
      reducer: rootReducer,
      preloadedState: initialState
    })
  } = {}
) => {
  return {
    ...render(<Provider store={store}>{component}</Provider>),
    store
  };
};
```

### 6. Testing Best Practices
```typescript
// 1. Use Data-testid for Reliable Selection
<div data-testid="unique-id">Content</div>

// In tests:
screen.getByTestId('unique-id')

// 2. Test User Interactions
it('should update on user input', () => {
  render(<Input />);
  const input = screen.getByRole('textbox');
  
  fireEvent.change(input, { target: { value: 'new value' } });
  expect(input.value).toBe('new value');
});

// 3. Test Error States
it('should handle error states', () => {
  render(<Form />);
  
  fireEvent.click(screen.getByText('Submit'));
  expect(screen.getByText('Required field')).toBeDefined();
});

// 4. Test Loading States
it('should show loading state', () => {
  render(<AsyncComponent />);
  
  expect(screen.getByText('Loading...')).toBeDefined();
});
```

